# Copia este archivo como .env y completa lo que tengas. Nada es obligatorio
# para arrancar: el panel (Ajustes) muestra que falta y que se pierde sin ello.
# Sin claves se puede ver el informe de ejemplo.

# Gemini: quien analiza los anuncios. https://aistudio.google.com > Get API key
GEMINI_API_KEY=
# Clave de reserva (otra cuenta de Google): se usa si la primera agota su cuota.
GEMINI_API_KEY_2=
# true si la clave tiene la facturacion activada: solo cambia el aviso de costo.
GEMINI_PAGO=false

# De donde salen los anuncios de la Biblioteca de Meta:
#   auto      = Apify si hay APIFY_TOKEN; si no, el navegador (por defecto)
#   navegador = GRATIS: el Chrome de este equipo lee la Biblioteca (publica, sin cuenta)
#   apify     = el actor de Apify (necesita token y credito)
ANUNCIOS_FUENTE=auto

# Apify (opcional). https://apify.com > Settings > API & Integrations > Personal API token
APIFY_TOKEN=
APIFY_TOKEN_2=

# ── KeyWords Explorer (Google Ads Keyword Planner) ───────────────────────
# Gratis, pero pide una cuenta de Google Ads y un developer token con acceso
# Basico. Guia paso a paso: panel > KeyWords Explorer > «Conectar Google Ads».
# Sin esto el modulo funciona con datos de DEMOSTRACION (claramente marcados).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Se obtiene una vez con:  python -m app.keywords.autorizar
GOOGLE_ADS_REFRESH_TOKEN=
# Cuenta de Google Ads desde la que se consulta (10 digitos, con o sin guiones).
GOOGLE_ADS_CUSTOMER_ID=
# Solo si entras a esa cuenta a traves de una cuenta administradora (MCC).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Las versiones de la API caducan al ano: si da 404, sube el numero.
GOOGLE_ADS_API_VERSION=v24

# ── Plan SEO: Google Search Console de la web propia (opcional) ──────────
# Usa la misma autorizacion de Google que Google Ads: GOOGLE_ADS_CLIENT_ID/SECRET
# y el refresh token de `python -m app.keywords.autorizar` (pide los dos permisos).
# Tu cuenta de Google necesita acceso a la propiedad (basta «Restringido»).
# Propiedad tal como aparece en Search Console: sc-domain:dominio o https://.../
GSC_PROPIEDAD=
# Solo las busquedas desde este pais (ISO de 3 letras, p. ej. per). Vacio = todos.
GSC_PAIS=per

# ── Plan SEO: enviar articulos a WordPress (opcional) ────────────────────
# En WordPress: Usuarios > Perfil > «Contraseñas de aplicación» > Añadir nueva.
# Es distinta de tu contraseña de acceso y se puede revocar sola. Hace falta https.
WP_URL=
WP_USUARIO=
WP_CLAVE_APLICACION=
# Con imagen destacada, el Radar pone el bloque «Imagen destacada» al inicio del texto
# (la plantilla de ilcb.edu.pe no la muestra sola). «no» si tu tema ya la muestra.
WP_DESTACADA_EN_TEXTO=

# ── Plan SEO: imagen destacada de los articulos (opcional) ───────────────
# Fotos gratis (uso comercial libre). Pixabay: crea una cuenta y copia la clave que aparece
# en https://pixabay.com/api/docs/ con la sesion iniciada.
PIXABAY_API_KEY=
# Alternativa, solo si no hay clave de Pixabay (en 2026-10 Pexels no daba claves nuevas).
PEXELS_API_KEY=
# Imagen generada con Gemini: usa GEMINI_API_KEY, pero la API NO tiene plan gratuito para
# imagenes: hace falta activar la facturacion en el proyecto de Google (~US$ 0.03 por imagen).
# Modelo (opcional): gemini-3.1-flash-lite-image (por defecto), gemini-3.1-flash-image, gemini-nano-banana-2.1
GEMINI_MODELO_IMAGEN=
